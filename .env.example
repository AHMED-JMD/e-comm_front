# Environment Variables Template
# Copy this file to .env.local and fill in your values

# API Configuration
# Local backend listens on PORT from e-comm_backend/.env (5050).
VITE_API_URL=http://localhost:5050/api
# Production (set this in the Vercel project's environment variables):
# VITE_API_URL=https://e-comm-backend-tan.vercel.app/api
VITE_API_TIMEOUT=10000

# Admin dashboard subdomain
# The dashboard is a second entry point (admin.html) served from its own host.
# By default the app derives the hosts from the current one:
#   store.com  <->  admin.store.com   (dev: localhost:3000 <-> admin.localhost:3000)
# Set these only when the two apps live on unrelated domains.
VITE_ADMIN_SUBDOMAIN=admin
# VITE_ADMIN_URL=https://admin.example.com
# VITE_STORE_URL=https://example.com

# App Configuration
VITE_APP_NAME=EComm Platform
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_PAYMENT=false
VITE_ENABLE_ANALYTICS=true

# Analytics
VITE_ANALYTICS_ID=your-analytics-id

# Support
VITE_SUPPORT_EMAIL=support@ecomm.com
VITE_SUPPORT_PHONE=+20 XXX XXX XXXX
